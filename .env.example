# Studio variables (spec 0003). Real values never go in the repo.
# Local: `vercel env pull` writes .env.local (git ignored). The Neon dev branch URLs live in
# .env.development.local on purpose, so a local `next build` never sees a database.

# "true" turns the studio on. Development and Production (spec 0005); never Preview.
STUDIO_ENABLED=

# Pooled Neon connection for runtime queries (injected by the Neon integration).
DATABASE_URL=

# Direct Neon connection for migrations (injected by the Neon integration).
DATABASE_URL_UNPOOLED=

# Production branch database host name (not a secret). Set in Preview so a preview build refuses to migrate production.
STUDIO_PROD_DB_HOST=

# Private Blob store token: studio-dev in Development and Preview, studio-prod in Production.
BLOB_READ_WRITE_TOKEN=

# Studio login (spec 0005). The passkey domain and the exact browser origin.
# Development: localhost and http://localhost:3000. Production: the host the studio is served from, and https://<that host>.
STUDIO_RP_ID=
STUDIO_ORIGIN=

# One time setup token, at least 32 characters, set only while enrolling or recovering a passkey, then removed (redeploy both times).
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
STUDIO_SETUP_TOKEN=
# Lead intake, spec 0010. Default off. Never enable Preview or put real data in local fixtures.
LEAD_INTAKE_ENABLED=false
LEAD_INTAKE_WORKSPACE_ID=
LEAD_INTAKE_ORIGIN=
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
RESEND_API_KEY=
INQUIRY_ALERT_FROM=
INQUIRY_ALERT_TO=
INQUIRY_RATE_SECRET=
CRON_SECRET=
