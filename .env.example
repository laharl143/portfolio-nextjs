# Studio variables (spec 0003). Real values never go in the repo.
# Local: `vercel env pull` writes .env.local (git ignored). The Neon dev branch URLs live in
# .env.development.local on purpose, so a local `next build` never sees a database.

# "true" turns the studio on. Development only until feature 21 (studio login) ships.
STUDIO_ENABLED=

# Pooled Neon connection for runtime queries (injected by the Neon integration).
DATABASE_URL=

# Direct Neon connection for migrations (injected by the Neon integration).
DATABASE_URL_UNPOOLED=

# Production branch database host name (not a secret). Set in Preview so a preview build refuses to migrate production.
STUDIO_PROD_DB_HOST=

# Private Blob store token: studio-dev in Development and Preview, studio-prod in Production.
BLOB_READ_WRITE_TOKEN=
